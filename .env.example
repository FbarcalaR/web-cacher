# All variables are required in Vercel (Production + Preview).
# Locally, copy this file to `.env.local` and fill in values.

# Single shared password for the app.
APP_PASSWORD=change-me

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me

# Vercel Postgres / Neon. Vercel sets this automatically once the
# database is linked to the project under Storage → Postgres.
POSTGRES_URL=

# Vercel Blob. Set automatically once the Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# Scraping service API key. Chosen + filled in during Phase 3.
SCRAPER_API_KEY=
