# All variables are required in Vercel (Production + Preview).
# Locally, copy this file to `.env.local` and fill in values.

# Single shared password for the app.
APP_PASSWORD=change-me

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me

# Vercel Postgres / Neon. Both are set automatically once the database
# is linked to the project under Storage → Postgres.
#   POSTGRES_URL              — pooled, used by the app at runtime.
#   POSTGRES_URL_NON_POOLING  — direct, used by drizzle-kit migrations.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob. Set automatically once the Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# Scraping service. One of: scrapingant | scrapingbee | scraperapi | zenrows | oxylabs.
# Default is scrapingant — only provider with a genuinely recurring monthly
# free tier (10k credits/mo, no card needed) that includes residential
# proxies. Smoke-test with `pnpm scrape:smoke <provider>` before deploying.
SCRAPER_PROVIDER=scrapingant
SCRAPER_API_KEY=

# Per-host override for ImmoScout24. DataDome (their bot screen) is too
# hard for ScrapingAnt's residential proxies — set this to "oxylabs"
# (or any other supported provider that handles DataDome) and supply a
# matching key below. Leave both unset to route ImmoScout24 through
# SCRAPER_PROVIDER above.
#
# Oxylabs API key format is "username:password" — copy both halves from
# your dashboard into one string.
SCRAPER_PROVIDER_IMMOSCOUT24=
SCRAPER_API_KEY_IMMOSCOUT24=
